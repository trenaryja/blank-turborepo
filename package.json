{
	"name": "blank-turborepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"fix": "prettier -w . && eslint --fix .",
		"check": "tsc && prettier -c . && eslint .",
		"make:app": "bun scripts/make-app.ts",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install"
	},
	"devDependencies": {
		"@trenaryja/config": "^0.0.1",
		"turbo": "^2.10.10"
	},
	"prettier": "@trenaryja/config/prettier",
	"trustedDependencies": [
		"esbuild",
		"unrs-resolver"
	],
	"packageManager": "bun@1.3.11"
}
